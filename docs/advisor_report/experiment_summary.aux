\@writefile{toc}{\contentsline {section}{\numberline {3}Two Communication Protocols: PQ-STF versus IE-STF}{2}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces The essential protocol difference. PQ-STF sends a 256-D query state that ego consumes inside its decoder; IE-STF sends a directly comparable 128-D embedding. In both cases, box geometry and confidence remain necessary for final box fusion.}}{3}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.1}PQ-STF: propagated-query Spatial TrackFormer}{3}{}\protected@file@percent }
