\@writefile{toc}{\contentsline {section}{\numberline {4}Noise Sensitivity and Annealing}{4}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Cross-agent top-1 association sensitivity under geometry-only localization noise. Color identifies the perturbation type: position only, heading only, or both. Solid lines are the clean-trained PQ-STF encoder; dashed lines are the annealed encoder. At $\alpha =1$, the applied standard deviations are 1 m and/or $5^\circ $; subsequent points use $(2\text  { m},10^\circ )$, $(4\text  { m},20^\circ )$, and $(10\text  { m},30^\circ )$. Higher is better.}}{4}{}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:association-sensitivity}{{3}{4}{}{}{}}
\@writefile{toc}{\contentsline {paragraph}{How to read Fig.~\ref {fig:association-sensitivity}.}{4}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces End-to-end vehicle AP@0.7 under combined position/heading localization noise. This is the AP study, not the association top-1 study. Every TrackFormer curve is \emph  {PQ-STF with BELT}: source CAVs transmit propagated 256-D query states, ego conditions its decoder on them, and BELT performs final uncertainty-aware box fusion. ``Annealed PQ-STF + codebook + BELT'' uses an 8-B query-state code, a $1024/8=128\times $ reduction of the raw 1024-B association state; geometry/score and protocol overhead are excluded from that ratio.}}{5}{}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces AP@0.7 values used in the combined localization-noise figure. All PQ-STF rows use propagated-query association and BELT box fusion; they are not IE-STF or simple-fusion results.}}{5}{}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Why AP rises again after extreme noise.}{5}{}\protected@file@percent }
