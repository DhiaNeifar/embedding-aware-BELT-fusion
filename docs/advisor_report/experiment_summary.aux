\@writefile{toc}{\contentsline {subsection}{\numberline {7.1}What the uncertainty figures measure}{8}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {7.2}How adaptive rate is selected}{8}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces How to read the fixed-rate compression trade-off. Each categorical x-axis label gives the query-state payload per selected source object and its compression factor relative to raw 1024 B. The y-axis is clean end-to-end AP@0.7 in percent; it is intentionally zoomed around 76.5\% to reveal the small differences. The plot shows that 4--16 B retains essentially the same measured AP as raw state, while transmitting 64--256$\times $ fewer association-state bytes.}}{9}{}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces Adaptive 1/2/4-B residual coding, official clean test.}}{9}{}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Conclusion.}{9}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Probability density functions for source-proposal uncertainty on the official clean test set. Blue curves are ground-truth matched detector proposals; orange curves are unmatched proposals. The orange distributions shift toward higher uncertainty for classification, position, and heading, which provides a source-local signal for allocating more message bits to riskier detections.}}{10}{}\protected@file@percent }
\newlabel{fig:uncertainty-pdf}{{6}{10}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Validation-calibrated adaptive coding policy. Left: matched and unmatched source proposals separate by within-source uncertainty rank; dashed lines are $t_1=0.61$ and $t_2=0.64$. Right: the learned allocation gives most low-uncertainty proposals 1 B and gives high-uncertainty, more often unmatched proposals 4 B. This explains the adaptive mechanism rather than merely reporting its final mean rate.}}{10}{}\protected@file@percent }
\newlabel{fig:adaptive-rate}{{7}{10}{}{}{}}
